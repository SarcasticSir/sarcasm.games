{
  "name": "sarcasm-games",
  "private": true,
  "version": "1.0.0",
  "dependencies": {
    "@supabase/supabase-js": "^2.99.3",
    "pg": "^8.13.1"
  },
  "scripts": {
    "switch:main": "bash scripts/switch-to-main.sh",
    "verify:main": "bash scripts/verify-main-ready.sh",
    "test:tiermaker": "node --test tiermaker/tiermaker.test.mjs",
    "test:tiermaker:browser": "node scripts/tiermaker-browser-test.mjs",
    "quiz:baseline": "node scripts/quiz-load-baseline.mjs",
    "quiz:baseline:target": "node scripts/quiz-load-baseline.mjs --duration-seconds 1800 --concurrency 200",
    "news:install": "node scripts/install-gaming-news.mjs",
    "news:generate": "node scripts/gaming-news.mjs",
    "news:validate": "node scripts/validate-gaming-news.mjs",
    "news:local:prepare": "node scripts/gaming-news-local.mjs prepare",
    "news:local:publish": "node scripts/gaming-news-local.mjs publish .gaming-news/codex-output.json",
    "test:news": "node --test scripts/gaming-news.test.mjs"
  }
